{
  "name": "prestige-be",
  "version": "1.0.0",
  "description": "Prestige Business Units — Sales & Delivery backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sequelize": "node -r dotenv/config node_modules/sequelize-cli/lib/sequelize",
    "update": "npm install && npm run db:migrate && npm run db:seed:catalog && npm run sequelize -- db:migrate:status",
    "db:seed:catalog": "npm run sequelize -- db:seed --seed catalog-items.cjs",
    "db:migrate": "npm run sequelize -- db:migrate",
    "db:migrate:undo": "npm run sequelize -- db:migrate:undo",
    "db:migrate:undo:all": "npm run sequelize -- db:migrate:undo:all",
    "db:seed": "npm run sequelize -- db:seed:all",
    "db:seed:roles": "npm run sequelize -- db:seed --seed roles-permissions.cjs",
    "db:seed:pages": "npm run sequelize -- db:seed --seed unit-pages.cjs",
    "db:seed:superadmin": "npm run sequelize -- db:seed --seed superadmin.cjs",
    "db:seed:undo": "npm run sequelize -- db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
